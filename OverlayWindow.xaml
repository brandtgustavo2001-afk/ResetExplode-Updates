<Window x:Class="ResetExplode.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RESET EXPLODE overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Box" Background="#E610141C" BorderBrush="#405A7186" BorderThickness="1" CornerRadius="10" Padding="16,12">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel x:Name="OverlayTextRoot" TextElement.FontFamily="Segoe UI" TextElement.FontSize="12" TextElement.Foreground="#F5F5F5" MaxWidth="420">
            <DockPanel Margin="0,0,0,8"><Border Width="3" Height="12" CornerRadius="1" Background="#62D5FF" Margin="0,0,7,0"/><TextBlock Text="RESET / PERFORMANCE" FontSize="9" FontWeight="SemiBold" Foreground="#B5C4D4"/></DockPanel>
            <!-- FPS em destaque (cada parte aparece só se escolhida na aba Overlay) -->
            <StackPanel x:Name="OFpsRow" Orientation="Horizontal">
                <TextBlock x:Name="OFps" Text="—" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="OFpsUnit" Text=" FPS" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <TextBlock x:Name="OFrameTime" Text="" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
            </StackPanel>
            <TextBlock x:Name="OLow" Text="1% low —" Foreground="#B5C4D4" Margin="0,2,0,0"/>
            <!-- Gráfico de frametime -->
            <Canvas x:Name="OGraph" Width="260" Height="32" HorizontalAlignment="Left" Margin="0,10,0,8" ClipToBounds="True"/>
            <!-- Linhas de sensores: GPU, VRAM, CPU, RAM... montadas pelo que foi escolhido -->
            <ItemsControl x:Name="ORows" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="54" SharedSizeGroup="Component"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="#62D5FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Parts}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="#16FFFFFF" CornerRadius="3" Padding="5,2" Margin="0,0,5,3"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="OGame" Text="" Foreground="#B5C4D4" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
